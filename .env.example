# Segredos locais de desenvolvimento; altere antes de expor qualquer serviço.
APP_ENV=development
POSTGRES_PASSWORD=local-only-change-me
DEV_AUTH_TOKEN=local-dev-token-change-me

# OIDC corporativo (obrigatório em APP_ENV=production)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=

# Em produção use URLs HTTPS e a origem do front-end publicada.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
